{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MonitoringScanRequestedEvent",
  "type": "object",
  "required": ["event_id", "event_type", "schema_version", "tenant_id", "subject_id", "resource_id", "authorization_version"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "type": "string", "const": "monitoring.scan.requested" },
    "schema_version": { "type": "string", "const": "1.0" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "subject_id": { "type": "string", "format": "uuid" },
    "resource_id": { "type": "string", "format": "uuid" },
    "authorization_version": { "type": "integer", "minimum": 1 },
    "trace_id": { "type": "string" }
  },
  "additionalProperties": false
}
